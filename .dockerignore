# Build output and self-contained release packages. These can be hundreds of MB
# and are not inputs to the relay image; the Dockerfile publishes its own image.
**/bin/
**/obj/
publish/
artifacts/
.build/

# Desktop-only projects and generated UI smoke images
src/VRS.RaceControl.Host/
src/VRS.RaceControl.Client/
src/VRS.RaceControl.ACBridge/
src/VRS.RaceControl.Shared.UI/
tools/
tests/
Commentator/

